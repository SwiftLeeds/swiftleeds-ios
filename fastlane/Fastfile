default_platform(:ios)

# fastlane otherwise writes fastlane/README.md on every run, and the file is
# not tracked.
skip_docs

platform :ios do
  desc "Build a scheme in a configuration. Both scheme: and configuration: are required"
  lane :build do |options|
    build_app(
      project: "SwiftLeeds.xcodeproj",
      # A missing option must fail the lane, never build a default.
      configuration: options.fetch(:configuration),
      scheme: options.fetch(:scheme),
      clean: true,
      skip_archive: true,
      skip_codesigning: true,
      xcargs: "-skipPackagePluginValidation"
    )
  end
end
