default_platform(:ios)

platform :ios do
  desc "Build a scheme in a given configuration"
  lane :build do |options|
    build_app(
      project: "SwiftLeeds.xcodeproj",
      # fetch, not [], so a missing or misspelt option fails the lane instead
      # of building some default under a step name that promises otherwise.
      configuration: options.fetch(:configuration),
      scheme: options.fetch(:scheme),
      clean: true,
      skip_archive: true,
      skip_codesigning: true,
      xcargs: "-skipPackagePluginValidation"
    )
  end
end
